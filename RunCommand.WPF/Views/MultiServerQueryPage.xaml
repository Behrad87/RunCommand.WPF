<Page x:Class="RunCommand.WPF.Views.MultiServerQueryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:RunCommand.WPF.Converters"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Multi-Server Query" FlowDirection="LeftToRight">

    <Page.Resources>
        <conv:StatusToBrushConverter x:Key="StatusToBrush"/>

        <!-- Explicit checkbox style: MD checkboxes in DataGrid cells often render invisible. -->
        <Style x:Key="GridCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Foreground}"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Visibility" Value="Visible"/>
            <Setter Property="materialDesign:CheckBoxAssist.CheckBoxSize" Value="18"/>
        </Style>

        <!-- SSMS / Azure Data Studio–style SQL editor surface -->
        <SolidColorBrush x:Key="SqlEditorBackground" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="SqlEditorForeground" Color="#D4D4D4"/>
        <SolidColorBrush x:Key="SqlEditorCaret" Color="#AE81FF"/>
        <SolidColorBrush x:Key="SqlEditorSelection" Color="#264F78"/>
        <SolidColorBrush x:Key="SqlEditorBorder" Color="#3C3C3C"/>
        <SolidColorBrush x:Key="SqlEditorHeaderBg" Color="#252526"/>
        <SolidColorBrush x:Key="SqlEditorKeywordHint" Color="#569CD6"/>

        <Style x:Key="SqlEditorTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource SqlEditorBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource SqlEditorForeground}"/>
            <Setter Property="CaretBrush" Value="{StaticResource SqlEditorCaret}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource SqlEditorSelection}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Courier New"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="AcceptsTab" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="0"
                                          Background="Transparent"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*" MinHeight="120"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1.5*" MinHeight="100"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: wraps on narrow widths -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="160"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Search servers..."
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,8,0"
                     VerticalContentAlignment="Center"
                     MinHeight="40"/>
            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Add Server..." Command="{Binding AddServerCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}" Margin="0,2,6,2" MinWidth="110"/>
                <Button Content="Remove Selected" Command="{Binding RemoveSelectedCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,2,6,2" MinWidth="110"/>
                <Button Content="Check Selected" Command="{Binding CheckSelectedStatusCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,2,6,2" MinWidth="110"/>
                <Button Content="Check All" Command="{Binding CheckAllStatusCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,2,0,2" MinWidth="90"/>
            </WrapPanel>
        </Grid>

        <!-- Server grid -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding ServersView}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserResizeRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  materialDesign:DataGridAssist.CellPadding="8,4,8,4"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="8,8,8,8"
                  Style="{StaticResource MaterialDesignDataGrid}"
                  RowHeight="36"
                  ColumnHeaderHeight="36">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="48" MinWidth="48" CanUserResize="False">
                    <DataGridTemplateColumn.Header>
                        <CheckBox Style="{StaticResource GridCheckBoxStyle}"
                                  ToolTip="Select / deselect all visible"
                                  Command="{Binding DataContext.ToggleSelectAllCommand, RelativeSource={RelativeSource AncestorType=Page}}"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox Style="{StaticResource GridCheckBoxStyle}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="●" Width="36" MinWidth="36" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Ellipse Width="12" Height="12"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Fill="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                     ToolTip="{Binding LastError}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="120"/>
                <DataGridTextColumn Header="Host" Binding="{Binding HostName}" Width="*" MinWidth="100"/>
                <DataGridTextColumn Header="Database" Binding="{Binding DatabaseName}" Width="*" MinWidth="100"/>
                <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="100" MinWidth="80"/>
                <DataGridTextColumn Header="Last Checked" Binding="{Binding LastCheckedDisplay}" Width="110" MinWidth="90" IsReadOnly="True"/>
                <DataGridTextColumn Header="Response" Binding="{Binding ResponseTimeDisplay}" Width="90" MinWidth="70" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Query input — SQL editor theme -->
        <Grid Grid.Row="2" Margin="0,10,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,8,0"
                    Background="{StaticResource SqlEditorBackground}"
                    BorderBrush="{StaticResource SqlEditorBorder}"
                    BorderThickness="1"
                    CornerRadius="4"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource SqlEditorHeaderBg}"
                            BorderBrush="{StaticResource SqlEditorBorder}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="4,4,0,0" Padding="10,5">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="SQL" FontWeight="SemiBold" FontSize="11"
                                       Foreground="{StaticResource SqlEditorKeywordHint}"
                                       VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Left" Margin="8,0,0,0"
                                       Text="Query editor" FontSize="11" Opacity="0.55"
                                       Foreground="{StaticResource SqlEditorForeground}"
                                       VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="Tab indent · multi-line"
                                       FontSize="10" Opacity="0.4"
                                       Foreground="{StaticResource SqlEditorForeground}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <TextBox Grid.Row="1"
                             Text="{Binding SqlText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SqlEditorTextBoxStyle}"
                             MinHeight="72" MaxHeight="180" Height="96"
                             materialDesign:HintAssist.Hint="SELECT * FROM ..."
                             materialDesign:HintAssist.Foreground="#6A9955"
                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Bottom">
                <Button Content="Run Query" Command="{Binding RunQueryCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="0,0,0,6" MinWidth="110"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        MinWidth="110"/>
            </StackPanel>
        </Grid>

        <!-- Progress -->
        <ProgressBar Grid.Row="3" Margin="0,0,0,8" Height="6"
                     Minimum="0" Maximum="{Binding ProgressTotal}" Value="{Binding ProgressCurrent}"
                     Style="{StaticResource MaterialDesignLinearProgressBar}"/>

        <!-- Results -->
        <DataGrid Grid.Row="4" ItemsSource="{Binding Results}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserResizeRows="False"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  materialDesign:DataGridAssist.CellPadding="8,4,8,4"
                  Style="{StaticResource MaterialDesignDataGrid}"
                  RowHeight="36" ColumnHeaderHeight="36">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Server" Binding="{Binding ServerName}" Width="*" MinWidth="120"/>
                <DataGridTextColumn Header="Host" Binding="{Binding HostName}" Width="*" MinWidth="100"/>
                <DataGridTemplateColumn Header="OK" Width="44" MinWidth="44" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Ellipse Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#D93333"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Success}" Value="True">
                                                <Setter Property="Fill" Value="#2EA04A"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Rows" Binding="{Binding RowsAffectedOrReturned}" Width="70" MinWidth="60"/>
                <DataGridTextColumn Header="Duration (ms)" Binding="{Binding DurationMs}" Width="110" MinWidth="90"/>
                <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="2*" MinWidth="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="5" Text="{Binding StatusMessage}" Margin="0,8,0,0" Opacity="0.7"
                   TextWrapping="Wrap"/>
    </Grid>
</Page>
