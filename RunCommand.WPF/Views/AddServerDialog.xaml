<Window x:Class="RunCommand.WPF.Views.AddServerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:RunCommand.WPF.Converters"
        Title="Add Server(s)" Height="560" Width="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        MinHeight="480" MinWidth="560">

    <Window.Resources>
        <conv:StatusToBrushConverter x:Key="StatusToBrush"/>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" x:Name="ModeTabs">

            <!-- ===================== Manual entry - one server ===================== -->
            <TabItem Header="Manual Entry">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Name" Grid.Row="0"/>
                    <TextBox x:Name="NameBox" Grid.Row="1" Margin="0,0,0,8" Padding="4"/>

                    <TextBlock Text="Host / IP (or \instance, or (localdb)\Instance)" Grid.Row="2"/>
                    <Grid Grid.Row="3" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="HostBox" Grid.Column="0" Padding="4" Margin="0,0,4,0"/>
                        <TextBox x:Name="PortBox" Grid.Column="1" Padding="4" Text="1433"/>
                    </Grid>

                    <TextBlock Text="Database" Grid.Row="4"/>
                    <TextBox x:Name="DatabaseBox" Grid.Row="5" Margin="0,0,0,8" Padding="4"/>

                    <TextBlock Text="Group / Region" Grid.Row="6"/>
                    <TextBox x:Name="GroupBox" Grid.Row="7" Margin="0,0,0,8" Padding="4"/>

                    <StackPanel Grid.Row="8" Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox x:Name="WindowsAuthCheck" Content="Windows Authentication" Checked="AuthModeChanged" Unchecked="AuthModeChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Row="9">
                        <TextBlock Text="Username" x:Name="UserLabel"/>
                        <TextBox x:Name="UserBox" Margin="0,0,0,8" Padding="4"/>
                        <TextBlock Text="Password" x:Name="PassLabel"/>
                        <PasswordBox x:Name="PassBox" Margin="0,0,0,8" Padding="4"/>
                        <TextBlock x:Name="TestResultText" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Ellipse x:Name="TestDot" Width="12" Height="12" Fill="#9E9E9E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <Button Content="Test Connection" Click="TestConnection_Click" Padding="10,4" Margin="0,0,8,0"/>
                        <Button Content="Save" Click="Save_Click" Padding="14,4" IsDefault="True"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ===================== Paste connection string(s) - one or many ===================== -->
            <TabItem Header="From Connection String(s)">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,4"
                               Text="Paste one connection string per line, or import a CSV file below. Works with LocalDB, named instances, host,port, or any ADO.NET SQL Server connection string. CSV format: a 'ConnectionString' column (plus optional 'Name' and 'Group' columns) - or, with no header, one connection string per row."/>

                    <TextBox x:Name="ConnStringsBox" Grid.Row="1" Height="90" AcceptsReturn="True"
                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11" Padding="6" Margin="0,0,0,8"
                             TextChanged="ConnStringsBox_TextChanged"/>

                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Group / Region for all:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="BulkGroupBox" Grid.Column="1" Padding="4" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Content="Import CSV..." Click="ImportCsv_Click" Padding="10,4" Margin="0,0,8,0"/>
                        <Button Grid.Column="3" Content="Test All" Click="TestAll_Click" Padding="10,4"/>
                    </Grid>

                    <TextBlock Grid.Row="3" x:Name="ParseSummaryText" Margin="0,0,0,4" Opacity="0.8"/>

                    <ListView Grid.Row="4" x:Name="ParsedList" BorderThickness="1" BorderBrush="#DDD">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="●" Width="28">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="12" Height="12" Fill="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Name" Width="140" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Data Source" Width="150" DisplayMemberBinding="{Binding DataSource}"/>
                                <GridViewColumn Header="Database" Width="80" DisplayMemberBinding="{Binding Database}"/>
                                <GridViewColumn Header="From" Width="90" DisplayMemberBinding="{Binding Source}"/>
                                <GridViewColumn Header="Message" Width="120" DisplayMemberBinding="{Binding Message}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Add All Parsed" Click="AddAll_Click" Padding="14,4" IsDefault="True"/>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Padding="14,4" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
