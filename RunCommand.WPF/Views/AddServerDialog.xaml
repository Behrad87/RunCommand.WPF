<Window x:Class="RunCommand.WPF.Views.AddServerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:RunCommand.WPF.Converters"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Add Server(s)" Height="560" Width="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        MinHeight="480" MinWidth="560"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        Background="{DynamicResource MaterialDesign.Brush.Background}">

    <Window.Resources>
        <conv:StatusToBrushConverter x:Key="StatusToBrush"/>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" x:Name="ModeTabs" Style="{StaticResource MaterialDesignFilledTabControl}">

            <!-- Manual entry -->
            <TabItem Header="Manual Entry">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="NameBox" Grid.Row="1" Margin="0,0,0,8"
                             materialDesign:HintAssist.Hint="Name"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                    <Grid Grid.Row="3" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="HostBox" Grid.Column="0" Margin="0,0,4,0"
                                 materialDesign:HintAssist.Hint="Host / IP (or \instance, or (localdb)\Instance)"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        <TextBox x:Name="PortBox" Grid.Column="1" Text="1433"
                                 materialDesign:HintAssist.Hint="Port"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    </Grid>

                    <TextBox x:Name="DatabaseBox" Grid.Row="5" Margin="0,0,0,8"
                             materialDesign:HintAssist.Hint="Database"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                    <TextBox x:Name="GroupBox" Grid.Row="7" Margin="0,0,0,8"
                             materialDesign:HintAssist.Hint="Group / Region"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                    <StackPanel Grid.Row="8" Orientation="Horizontal" Margin="0,0,0,8">
                        <CheckBox x:Name="WindowsAuthCheck" Content="Windows Authentication"
                                  Checked="AuthModeChanged" Unchecked="AuthModeChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Row="9">
                        <TextBox x:Name="UserBox" Margin="0,0,0,8"
                                 materialDesign:HintAssist.Hint="Username"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        <PasswordBox x:Name="PassBox" Margin="0,0,0,8"
                                     materialDesign:HintAssist.Hint="Password"
                                     Style="{StaticResource MaterialDesignOutlinedPasswordBox}"/>
                        <TextBlock x:Name="TestResultText" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Ellipse x:Name="TestDot" Width="12" Height="12" Fill="#9E9E9E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <Button Content="Test Connection" Click="TestConnection_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
                        <Button Content="Save" Click="Save_Click"
                                Style="{StaticResource MaterialDesignRaisedButton}" IsDefault="True"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Connection strings -->
            <TabItem Header="From Connection String(s)">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,4" Opacity="0.8"
                               Text="Paste one connection string per line, or import a CSV file below. Works with LocalDB, named instances, host,port, or any ADO.NET SQL Server connection string."/>

                    <TextBox x:Name="ConnStringsBox" Grid.Row="1" Height="90" AcceptsReturn="True"
                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11" Margin="0,0,0,8"
                             materialDesign:HintAssist.Hint="Connection strings (one per line)..."
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             TextChanged="ConnStringsBox_TextChanged"/>

                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="BulkGroupBox" Grid.Column="0" Margin="0,0,8,0"
                                 materialDesign:HintAssist.Hint="Group / Region for all"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        <Button Grid.Column="1" Content="Import CSV..." Click="ImportCsv_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" Content="Test All" Click="TestAll_Click"
                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                    </Grid>

                    <TextBlock Grid.Row="3" x:Name="ParseSummaryText" Margin="0,0,0,4" Opacity="0.8"/>

                    <ListView Grid.Row="4" x:Name="ParsedList"
                              Style="{StaticResource MaterialDesignListView}"
                              BorderThickness="1">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="●" Width="28">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="12" Height="12" Fill="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Name" Width="140" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Data Source" Width="150" DisplayMemberBinding="{Binding DataSource}"/>
                                <GridViewColumn Header="Database" Width="80" DisplayMemberBinding="{Binding Database}"/>
                                <GridViewColumn Header="From" Width="90" DisplayMemberBinding="{Binding Source}"/>
                                <GridViewColumn Header="Message" Width="120" DisplayMemberBinding="{Binding Message}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Add All Parsed" Click="AddAll_Click"
                                Style="{StaticResource MaterialDesignRaisedButton}" IsDefault="True"/>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Click="Cancel_Click"
                    Style="{StaticResource MaterialDesignOutlinedButton}" IsCancel="True"/>
        </StackPanel>

        <materialDesign:Snackbar x:Name="DialogSnackbar"
                                 Grid.RowSpan="2"
                                 VerticalAlignment="Bottom"
                                 HorizontalAlignment="Stretch"/>
    </Grid>
</Window>
