<Window x:Class="RunCommand.WPF.Views.AddServerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:RunCommand.WPF.Converters"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Add Server(s)" Height="680" Width="640"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        MinHeight="480" MinWidth="480"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        Background="{DynamicResource MaterialDesign.Brush.Background}">

    <Window.Resources>
        <conv:StatusToBrushConverter x:Key="StatusToBrush"/>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" x:Name="ModeTabs" Style="{StaticResource MaterialDesignFilledTabControl}">

            <!-- Manual entry - mirrors SSMS Connection Properties -->
            <TabItem Header="Manual Entry">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,10,10,0">
                    <StackPanel>
                        <TextBox x:Name="NameBox" Margin="0,0,0,12"
                                 materialDesign:HintAssist.Hint="Display name"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                        <TextBox x:Name="HostBox" Margin="0,0,0,12"
                                 materialDesign:HintAssist.Hint="Server name (e.g. host\instance,49149)"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                        <ComboBox x:Name="AuthModeBox" Margin="0,0,0,12"
                                  materialDesign:HintAssist.Hint="Authentication"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  SelectedIndex="0"
                                  SelectionChanged="AuthModeChanged">
                            <ComboBoxItem Content="SQL Server Authentication"/>
                            <ComboBoxItem Content="Windows Authentication"/>
                        </ComboBox>

                        <TextBox x:Name="UserBox" Margin="0,0,0,12"
                                 materialDesign:HintAssist.Hint="User name"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                        <PasswordBox x:Name="PassBox" Margin="0,0,0,8"
                                     materialDesign:HintAssist.Hint="Password"
                                     Style="{StaticResource MaterialDesignOutlinedPasswordBox}"/>

                        <CheckBox x:Name="RememberPasswordCheck" Content="Remember password"
                                  Style="{StaticResource MaterialDesignCheckBox}"
                                  IsChecked="True" Margin="0,0,0,12"/>

                        <TextBox x:Name="DatabaseBox" Margin="0,0,0,12"
                                 materialDesign:HintAssist.Hint="Database name"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                        <TextBox x:Name="GroupBox" Margin="0,0,0,12"
                                 materialDesign:HintAssist.Hint="Group / Region"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                        <ComboBox x:Name="EncryptBox" Margin="0,0,0,12"
                                  materialDesign:HintAssist.Hint="Encrypt"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="Mandatory" Tag="Mandatory"/>
                            <ComboBoxItem Content="Optional" Tag="Optional"/>
                            <ComboBoxItem Content="Strict" Tag="Strict"/>
                        </ComboBox>

                        <CheckBox x:Name="TrustServerCertCheck" Content="Trust server certificate"
                                  Style="{StaticResource MaterialDesignCheckBox}"
                                  IsChecked="True" Margin="0,0,0,12"/>

                        <TextBlock x:Name="TestResultText" Margin="0,0,0,8" TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                            <Ellipse x:Name="TestDot" Width="12" Height="12" Fill="#9E9E9E" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <Button Content="Test Connection" Click="TestConnection_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
                            <Button Content="Save" Click="Save_Click"
                                    Style="{StaticResource MaterialDesignRaisedButton}" IsDefault="True"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Connection strings -->
            <TabItem Header="From Connection String(s)">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,4" Opacity="0.8"
                               Text="Paste one connection string per line, or import a CSV file below. Works with LocalDB, named instances, host,port, or any ADO.NET SQL Server connection string."/>

                    <TextBox x:Name="ConnStringsBox" Grid.Row="1" Height="90" AcceptsReturn="True"
                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="11" Margin="0,0,0,8"
                             materialDesign:HintAssist.Hint="Connection strings (one per line)..."
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             TextChanged="ConnStringsBox_TextChanged"/>

                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="120"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="BulkGroupBox" Grid.Column="0" Margin="0,0,8,0"
                                 materialDesign:HintAssist.Hint="Group / Region for all"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Import CSV..." Click="ImportCsv_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,2,8,2"/>
                            <Button Content="Test All" Click="TestAll_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,2,0,2"/>
                        </WrapPanel>
                    </Grid>

                    <TextBlock Grid.Row="3" x:Name="ParseSummaryText" Margin="0,0,0,4" Opacity="0.8"/>

                    <ListView Grid.Row="4" x:Name="ParsedList"
                              Style="{StaticResource MaterialDesignListView}"
                              BorderThickness="1">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="●" Width="28">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="12" Height="12" Fill="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Name" Width="140" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Data Source" Width="150" DisplayMemberBinding="{Binding DataSource}"/>
                                <GridViewColumn Header="Database" Width="80" DisplayMemberBinding="{Binding Database}"/>
                                <GridViewColumn Header="From" Width="90" DisplayMemberBinding="{Binding Source}"/>
                                <GridViewColumn Header="Message" Width="120" DisplayMemberBinding="{Binding Message}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Add All Parsed" Click="AddAll_Click"
                                Style="{StaticResource MaterialDesignRaisedButton}" IsDefault="True"/>
                    </StackPanel>
                </Grid>
            </TabItem>

        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Click="Cancel_Click"
                    Style="{StaticResource MaterialDesignOutlinedButton}" IsCancel="True"/>
        </StackPanel>

        <materialDesign:Snackbar x:Name="DialogSnackbar"
                                 Grid.RowSpan="2"
                                 Panel.ZIndex="100"
                                 VerticalAlignment="Bottom"
                                 HorizontalAlignment="Stretch"
                                 Margin="8"/>
    </Grid>
</Window>
